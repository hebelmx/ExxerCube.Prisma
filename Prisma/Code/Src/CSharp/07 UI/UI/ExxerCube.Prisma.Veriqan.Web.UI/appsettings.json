{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Veriqan": {
    "CsvReferenceData": {
      // Repo-root-relative path to the demo reference-data bundle. Resolved to an absolute
      // path at startup in Program.cs (DemoCorpusPathResolver walks up from the process's
      // base directory to the repository root, identified by CLAUDE.md) — a hardcoded
      // relative path would break because the Web.UI's working directory differs between
      // `dotnet run` (assembly under BuildArtifacts, a sibling of the repo) and a published
      // container.
      "RootDirectory": "Prisma/Fixtures/PRP2/demo/reference-bundle"
    },
    // VLD-S5a demo-host resilience/timeout tuning — Web.UI-scoped ONLY (does not touch the
    // Worker's config or GateResilienceOptions/DemoOptions defaults, which stay tuned for the
    // production/worker fail-closed posture). Bound via AddVeriqan(config) →
    // Configure<GateResilienceOptions>(config.GetSection("Veriqan:Gate:Resilience")).
    "Gate": {
      "Resilience": {
        // Raised from the 30s production default: this is the gate's OWN fail-closed timeout,
        // which fires INSIDE DemoRunner's own LiveTimeout below — it must be the larger of the
        // two or it always dominates and a cold-start live run never gets DemoRunner's full
        // budget.
        "TimeoutPerRequest": "00:01:00",
        // Relaxed from the 0.8 (80%) production default to 1.0 (100%): the demo breaker should
        // only trip when EVERY call in the sampling window fails, so a couple of bad/malformed
        // audience uploads can't blacken every card for the BreakDuration — other config keys
        // (MinimumThroughput, SamplingDuration, BreakDuration) are left at their defaults.
        "FailureRatio": 1.0
      }
    },
    // Effective live-mode cap for THIS demo host, below the 60s gate timeout above so DemoRunner
    // itself can still fall back to a canned case (rather than the gate cutting it off first),
    // while giving a cold-started process real slack over the 20s library default.
    "Demo": {
      "LiveTimeout": "00:00:45"
    }
  }
  // ConnectionStrings:VeriqanDb is intentionally OMITTED (VLD-S1 decision): this Web.UI demo
  // surface uses AddVeriqanInMemoryPersistence() (the fallback branch inside AddVeriqan when
  // no connection string is configured) — no SQL Server dependency for `dotnet run`. This is a
  // sales-demo surface, not a system of record; see VeriqanOrchestrationExtensions.cs ~L108-134.
}
