{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Veriqan": {
    "CsvReferenceData": {
      // Repo-root-relative path to the demo reference-data bundle. Resolved to an absolute
      // path at startup in Program.cs (DemoCorpusPathResolver walks up from the process's
      // base directory to the repository root, identified by CLAUDE.md) — a hardcoded
      // relative path would break because the Web.UI's working directory differs between
      // `dotnet run` (assembly under BuildArtifacts, a sibling of the repo) and a published
      // container.
      "RootDirectory": "Prisma/Fixtures/PRP2/demo/reference-bundle"
    }
  }
  // ConnectionStrings:VeriqanDb is intentionally OMITTED (VLD-S1 decision): this Web.UI demo
  // surface uses AddVeriqanInMemoryPersistence() (the fallback branch inside AddVeriqan when
  // no connection string is configured) — no SQL Server dependency for `dotnet run`. This is a
  // sales-demo surface, not a system of record; see VeriqanOrchestrationExtensions.cs ~L108-134.
}
