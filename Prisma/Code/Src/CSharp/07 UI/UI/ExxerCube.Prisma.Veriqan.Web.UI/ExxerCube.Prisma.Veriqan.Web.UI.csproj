<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Target framework centrally managed; do not add another here -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Suppress MudBlazor analyzer false positives (known 8.x bugs) -->
    <NoWarn>$(NoWarn);BL0008;MUD0002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- MudBlazor version pinned centrally in Directory.Packages.props (8.11) -->
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Veriqan domain + application: real enums (VerdictSignal, FindingVerdict, BlockReason, etc.)
      and value objects (BlockedOutcome) consumed by the demo data service and page components.
      Direction: UI → Veriqan only; no Prisma domain reference needed for this demo surface.
    -->
    <ProjectReference Include="..\..\..\01 Core\Veriqan.Domain\ExxerCube.Prisma.Veriqan.Domain.csproj" />
    <ProjectReference Include="..\..\..\01 Core\Veriqan.Application\ExxerCube.Prisma.Veriqan.Application.csproj" />
    <!--
      VLD-S1: wires the real Veriqan VEC pipeline into this host. A single reference to
      Orchestration transitively pulls in the full Infrastructure.{Extraction,Persistence,
      ReferenceData,Reporting,Validation,Visual} graph (each is already referenced by
      Orchestration itself) — do not add those individually.
    -->
    <ProjectReference Include="..\..\..\03 Orchestration\Veriqan.Orchestration\ExxerCube.Prisma.Veriqan.Orchestration.csproj" />
  </ItemGroup>
</Project>
