@page "/red"
@rendermode InteractiveServer
@inject DemoDataService Demo

<PageTitle>Caso RED — Veriqan Demo</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Captura 3 — Hallazgos de Incumplimiento (RED)</MudText>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    CL-21 (aritmética) · CL-35 (fuente) · Archivo: <em>@_case.FileName</em>
</MudText>

<VerdictResult Case="@_case" ShowCheckGrid="true" />

@code {
    private DemoStatementCase _case = null!;

    protected override void OnInitialized()
    {
        _case = Demo.GetBySignal(VerdictSignal.Red)!;
    }
}
