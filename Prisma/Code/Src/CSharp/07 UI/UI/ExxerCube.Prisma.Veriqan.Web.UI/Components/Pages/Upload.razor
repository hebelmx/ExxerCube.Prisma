@page "/upload"
@rendermode InteractiveServer
@implements IDisposable
@inject DemoDataService Demo

<PageTitle>Ingesta y Extracción — Veriqan Demo</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Captura 1 — Ingesta y Extracción de Campos</MudText>
<MudText Typo="Typo.body2" Class="mb-6 mud-text-secondary">
    CL-1, CL-3, CL-6, CL-11, CL-12 · Corresponde al <em>Pipeline stage: Ingestion → Extraction</em>
</MudText>

<!-- Upload panel -->
<MudGrid>
    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.UploadFile" Class="mr-2" />
                Subir estado de cuenta (PDF)
            </MudText>

            @if (!_submitted)
            {
                <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf" MaximumFileCount="1">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.AttachFile">
                            Seleccionar archivo PDF…
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>

                @if (_selectedFileName is not null)
                {
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Color="Color.Error" />
                        @_selectedFileName
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3"
                               StartIcon="@Icons.Material.Filled.Send"
                               OnClick="SimulateSubmit">
                        Verificar
                    </MudButton>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mt-3 mud-text-secondary">
                        O haga clic en "Usar archivo de demo" para simular la ingesta.
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Class="mt-2"
                               OnClick="UseDemo">
                        Usar archivo de demo
                    </MudButton>
                }
            }
            else
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="_processing" Class="mb-3" />
                @if (!_processing)
                {
                    <MudAlert Severity="Severity.Success" Dense="true">
                        Documento recibido. Job ID: <strong>@_case?.JobId.ToString()[..8]…</strong>
                    </MudAlert>
                    <MudText Typo="Typo.caption" Class="mt-2 mud-text-secondary">
                        Hash SHA-256: <code>@(_case?.ExtractedFields.ContentHash[..32])…</code>
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Default" Class="mt-3"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               OnClick="Reset">
                        Reiniciar
                    </MudButton>
                }
            }
        </MudPaper>
    </MudItem>

    <!-- Extracted fields panel -->
    <MudItem xs="12" md="7">
        @if (_case is not null && !_processing)
        {
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.FindInPage" Class="mr-2" />
                    Campos extraídos
                </MudText>
                <MudSimpleTable Dense="true" Striped="true">
                    <tbody>
                        <tr><td><strong>Banco</strong></td><td>@_case.ExtractedFields.BankName</td></tr>
                        <tr><td><strong>Cuenta</strong></td><td>@_case.ExtractedFields.MaskedAccount</td></tr>
                        <tr><td><strong>Producto</strong></td><td>@_case.ExtractedFields.ProductType</td></tr>
                        <tr><td><strong>Período</strong></td><td>@_case.ExtractedFields.Period</td></tr>
                        <tr><td><strong>Fecha de corte</strong></td>
                            <td>@(_case.ExtractedFields.CutDate == default ? "(no extraído)" : _case.ExtractedFields.CutDate.ToString("dd/MM/yyyy"))</td></tr>
                        <tr><td><strong>Saldo inicial (MXN)</strong></td>
                            <td>@_case.ExtractedFields.OpeningBalance.ToString("C")</td></tr>
                        <tr><td><strong>Saldo final (MXN)</strong></td>
                            <td>@_case.ExtractedFields.ClosingBalance.ToString("C")</td></tr>
                        <tr><td><strong>Movimientos</strong></td><td>@_case.ExtractedFields.MovementCount</td></tr>
                        <tr><td><strong>Páginas</strong></td><td>@_case.ExtractedFields.PageCount</td></tr>
                        <tr>
                            <td><strong>Hash SHA-256</strong></td>
                            <td><code style="font-size:0.7rem;">@_case.ExtractedFields.ContentHash</code></td>
                        </tr>
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }
        else if (!_submitted)
        {
            <MudPaper Class="pa-4 d-flex align-center justify-center" Elevation="1"
                      Style="height:250px; border: 2px dashed var(--mud-palette-divider);">
                <MudText Typo="Typo.body2" Class="mud-text-secondary text-center">
                    Los campos extraídos aparecerán aquí<br />después de subir un estado de cuenta.
                </MudText>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

@code {
    private string? _selectedFileName;
    private bool _submitted;
    private bool _processing;
    private DemoStatementCase? _case;

    // Cancellation source tied to the component lifetime; the simulated-delay tasks
    // observe this token so they are cancelled if the component is disposed mid-run.
    private readonly CancellationTokenSource _cts = new();

    private void OnFileSelected(IBrowserFile? file)
    {
        _selectedFileName = file?.Name;
    }

    private async Task SimulateSubmit()
    {
        _submitted = true;
        _processing = true;
        StateHasChanged();
        try
        {
            await Task.Delay(1400, _cts.Token); // simulate pipeline ingestion
            _case = Demo.GetBySignal(VerdictSignal.Green);
        }
        catch (OperationCanceledException)
        {
            // Component disposed before the simulated delay completed — nothing to do.
            return;
        }
        _processing = false;
    }

    private async Task UseDemo()
    {
        // Neutral sample filename — carries no real account/card data.
        _selectedFileName = "estado-cuenta-visa-demo.pdf";
        StateHasChanged();
        try
        {
            await Task.Delay(50, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }
        await SimulateSubmit();
    }

    private void Reset()
    {
        _selectedFileName = null;
        _submitted = false;
        _processing = false;
        _case = null;
    }

    /// <summary>Cancels any in-flight simulated work when the component is disposed.</summary>
    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
