@* Reusable, parameterized presentational component: renders ONE DemoStatementCase, regardless
   of whether it came from the live pipeline (VerificationOutcomeMapper) or the canned
   DemoDataService. No @page route, no injected services, no data fetching — purely a view over
   the Case parameter. VLD-S5 will consume it from a live page; the 4 canned pages are untouched
   by this story. *@

<VerdictBanner Signal="@Case.Signal">
    <MudGrid Justify="Justify.Center">
        <MudItem><MudChip T="string" Color="Color.Success">@Case.PassCount Pass</MudChip></MudItem>
        <MudItem><MudChip T="string" Color="Color.Error">@Case.FailCount Fail</MudChip></MudItem>
        <MudItem><MudChip T="string" Color="Color.Default">@Case.InsufficientDataCount InsufficientData</MudChip></MudItem>
        <MudItem><MudChip T="string" Color="Color.Info">@Case.ProcessingDuration.TotalSeconds.ToString("F2") s</MudChip></MudItem>
    </MudGrid>
</VerdictBanner>

<!-- [N VISUAL] [M DATA] ribbon -->
<MudPaper Class="pa-3 mb-4" Elevation="1">
    @if (_visualFailCount == 0 && _dataFailCount == 0)
    {
        <MudAlert Severity="Severity.Success" Dense="true">Sin incumplimientos.</MudAlert>
    }
    else
    {
        <div style="display:flex; gap:8px; align-items:center;">
            <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Visibility">@_visualFailCount VISUAL</MudChip>
            <MudChip T="string" Color="Color.Error" Icon="@Icons.Material.Filled.Storage">@_dataFailCount DATA</MudChip>
        </div>
    }
</MudPaper>

<!-- Hero image: marked page(s), or graceful placeholder -->
<MudText Typo="Typo.h6" Class="mb-2">Página marcada</MudText>
<MudPaper Class="pa-3 mb-4" Elevation="1">
    @if (Case.MarkedPagePngs.Count > 0)
    {
        @foreach (var markedPage in _orderedMarkedPages)
        {
            <img src="@markedPage.DataUri" style="max-width:100%" alt="@markedPage.AltText" />
        }
    }
    else
    {
        <MudPaper Class="d-flex flex-column align-center justify-center" Elevation="0"
                  Style="height:520px; border:2px dashed var(--mud-palette-divider); border-radius:4px;">
            <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Large"
                     Color="Color.Error" Style="font-size:4rem;" />
            <MudText Typo="Typo.subtitle2" Class="mt-3">Página marcada</MudText>
            <MudText Typo="Typo.caption" Class="mt-1 mud-text-secondary text-center px-4">
                En producción, el pipeline genera una imagen con anotaciones visuales<br />
                que resaltan exactamente las zonas donde fallaron los checks.
            </MudText>
        </MudPaper>
    }
</MudPaper>

<!-- The rail: Fail (in finding order) -> InsufficientData -> collapsed Pass summary -->
<MudText Typo="Typo.h6" Class="mb-2">Hallazgos</MudText>
<MudPaper Elevation="1" Class="mb-4">
    @if (_railFailFindings.Count == 0 && _railInsufficientFindings.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Dense="true" Class="ma-2">Sin incumplimientos.</MudAlert>
    }
    else
    {
        <MudList T="string" Dense="true">
            @foreach (var finding in _railFailFindings)
            {
                <MudListItem T="string">
                    <ChildContent>
                        <div class="vec-rail-card">
                            <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                                <MudChip T="string" Size="Size.Small" Color="Color.Error">@finding.CheckId</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@finding.DofNumeral</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@TierChipColor(finding.Tier)">@TierChipText(finding.Tier)</MudChip>
                            </div>
                            <MudText Typo="Typo.body2" Class="mt-1">@finding.Label</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                Esperado: <code>@finding.Expected</code> · Observado: <code>@finding.Observed</code>
                            </MudText>
                        </div>
                    </ChildContent>
                </MudListItem>
            }
            @foreach (var finding in _railInsufficientFindings)
            {
                <MudListItem T="string">
                    <ChildContent>
                        <div class="vec-rail-card vec-rail-card-grey" style="opacity:0.75;">
                            <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@finding.CheckId</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">@finding.DofNumeral</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default">Datos insuficientes</MudChip>
                            </div>
                            <MudText Typo="Typo.body2" Class="mt-1">@finding.Label</MudText>
                        </div>
                    </ChildContent>
                </MudListItem>
            }
        </MudList>
    }
    @if (Case.PassCount > 0)
    {
        <MudText Typo="Typo.caption" Class="pa-2 mud-text-secondary">
            @Case.PassCount checks superados
        </MudText>
    }
</MudPaper>

@code {
    /// <summary>The demo case to render — the sole input to this presentational component.</summary>
    [Parameter, EditorRequired] public DemoStatementCase Case { get; set; } = null!;

    private int _visualFailCount;
    private int _dataFailCount;
    private IReadOnlyList<DemoFinding> _railFailFindings = [];
    private IReadOnlyList<DemoFinding> _railInsufficientFindings = [];
    private IReadOnlyList<MarkedPage> _orderedMarkedPages = [];

    protected override void OnParametersSet()
    {
        var failFindings = Case.Findings.Where(f => f.Verdict == FindingVerdict.Fail).ToList();
        _visualFailCount = failFindings.Count(f => f.IsVisual);
        _dataFailCount = failFindings.Count(f => !f.IsVisual);

        // Preserve Case.Findings order (matches the hero's numbered callouts — do not re-sort).
        _railFailFindings = failFindings;
        _railInsufficientFindings = Case.Findings
            .Where(f => f.Verdict == FindingVerdict.InsufficientData)
            .ToList();

        _orderedMarkedPages = Case.MarkedPagePngs
            .OrderBy(kvp => kvp.Key)
            .Select(kvp => new MarkedPage(
                kvp.Key,
                $"data:image/png;base64,{Convert.ToBase64String(kvp.Value)}",
                $"Página marcada {kvp.Key}"))
            .ToList();
    }

    private static Color TierChipColor(ChecklistTier tier) => tier switch
    {
        ChecklistTier.Condusef or ChecklistTier.Both => Color.Error,
        ChecklistTier.Bank => Color.Warning,
        _ => Color.Default,
    };

    private static string TierChipText(ChecklistTier tier) => tier switch
    {
        ChecklistTier.Condusef or ChecklistTier.Both => "[RED · fails checklist AND law]",
        ChecklistTier.Bank => "[AMBER · fails law only — not on bank checklist]",
        _ => string.Empty,
    };

    private sealed record MarkedPage(int PageNumber, string DataUri, string AltText);
}
