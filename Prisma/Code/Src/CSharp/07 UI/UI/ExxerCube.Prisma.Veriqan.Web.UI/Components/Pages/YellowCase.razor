@page "/yellow"
@rendermode InteractiveServer
@inject DemoDataService Demo

<PageTitle>Caso YELLOW — Veriqan Demo</PageTitle>

<MudText Typo="Typo.h5" Class="mb-1">Captura 4 — Oportunidades de Mejora (YELLOW)</MudText>
<MudText Typo="Typo.body2" Class="mb-4 mud-text-secondary">
    CL-35 (fuente) · CL-37 (contraste) · CONDUSEF en regla · Archivo: <em>@_case.FileName</em>
</MudText>

<!-- Verdict banner -->
<VerdictBanner Signal="VerdictSignal.Yellow">
    <MudGrid Justify="Justify.Center">
        <MudItem><MudChip T="string" Color="Color.Success">@_case.PassCount Pass</MudChip></MudItem>
        <MudItem><MudChip T="string" Color="Color.Warning">@_case.FailCount Mejora banco</MudChip></MudItem>
        <MudItem><MudChip T="string" Color="Color.Default">@_case.InsufficientDataCount InsufficientData</MudChip></MudItem>
        <MudItem><MudChip T="string" Color="Color.Info">@_case.ProcessingDuration.TotalSeconds.ToString("F2") s</MudChip></MudItem>
    </MudGrid>
</VerdictBanner>

<!-- Main split layout: grid + detail side-by-side -->
<MudGrid>
    <!-- Left: check grid + tier-grouped detail -->
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6" Class="mb-2">Grilla de verificación</MudText>
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <div style="display:flex; flex-wrap:wrap; gap:6px;">
                @foreach (var f in _case.Findings)
                {
                    var cssClass = f.Verdict switch
                    {
                        FindingVerdict.Pass => "vec-check-cell vec-check-pass",
                        FindingVerdict.Fail => "vec-check-cell vec-check-fail",
                        _ => "vec-check-cell vec-check-insufficient",
                    };
                    var tooltip = f.Verdict == FindingVerdict.Fail
                        ? $"{f.CheckId}: {f.Label} | Esperado: {f.Expected} | Observado: {f.Observed}"
                        : $"{f.CheckId}: {f.Label}";
                    <MudTooltip Text="@tooltip">
                        <div class="@cssClass">@f.CheckId.Replace("CL-", "")</div>
                    </MudTooltip>
                }
            </div>
        </MudPaper>

        <!-- ── CONDUSEF section (will be empty for YELLOW) ─────────────────── -->
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Cancel" Color="Color.Error" Style="vertical-align:middle;" />
            Incumplimiento CONDUSEF (RED)
        </MudText>
        <MudPaper Elevation="1" Class="mb-4">
            @if (_condusefFailFindings.Count == 0)
            {
                <MudAlert Severity="Severity.Success" Dense="true" Class="ma-2">
                    Sin incumplimientos CONDUSEF — estado conforme a nivel regulatorio.
                </MudAlert>
            }
            else
            {
                <MudTable Items="_condusefFailFindings" Dense="true" Hover="true" Class="mb-0">
                    <HeaderContent>
                        <MudTh>Check</MudTh>
                        <MudTh>Tier</MudTh>
                        <MudTh>Verificación</MudTh>
                        <MudTh>Severidad</MudTh>
                        <MudTh>Esperado</MudTh>
                        <MudTh>Observado</MudTh>
                        <MudTh>DOF</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">@context.CheckId</MudChip>
                        </MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.Tier</MudChip>
                        </MudTd>
                        <MudTd>@context.Label</MudTd>
                        <MudTd><MudText Typo="Typo.caption">@context.Severity</MudText></MudTd>
                        <MudTd><code>@context.Expected</code></MudTd>
                        <MudTd><code style="color:var(--mud-palette-error);">@context.Observed</code></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@context.DofNumeral</MudText></MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <!-- ── Bank improvement opportunities ─────────────────────────────── -->
        <MudText Typo="Typo.h6" Class="mb-2">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Style="vertical-align:middle;" />
            Oportunidades de mejora del banco (YELLOW)
        </MudText>
        <MudPaper Elevation="1" Class="mb-4">
            @if (_bankFailFindings.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="ma-2">Sin oportunidades de mejora identificadas.</MudAlert>
            }
            else
            {
                <MudTable Items="_bankFailFindings" Dense="true" Hover="true" Class="mb-0">
                    <HeaderContent>
                        <MudTh>Check</MudTh>
                        <MudTh>Verificación</MudTh>
                        <MudTh>Severidad</MudTh>
                        <MudTh>Esperado</MudTh>
                        <MudTh>Observado</MudTh>
                        <MudTh>DOF</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning">@context.CheckId</MudChip>
                        </MudTd>
                        <MudTd>@context.Label</MudTd>
                        <MudTd><MudText Typo="Typo.caption">@context.Severity</MudText></MudTd>
                        <MudTd><code>@context.Expected</code></MudTd>
                        <MudTd><code style="color:var(--mud-palette-warning);">@context.Observed</code></MudTd>
                        <MudTd><MudText Typo="Typo.caption">@context.DofNumeral</MudText></MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudItem>

    <!-- Right: explanation panel -->
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6" Class="mb-2">¿Qué significa YELLOW?</MudText>
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudAlert Severity="Severity.Warning" Class="mb-3">
                <MudText Typo="Typo.subtitle2">CONDUSEF en regla — el banco puede mejorar</MudText>
            </MudAlert>
            <MudText Typo="Typo.body2" Class="mb-3">
                El estado de cuenta cumple todos los requisitos regulatorios de CONDUSEF.
                Sin embargo, el banco tiene oportunidades de mejorar su estándar interno:
            </MudText>
            <MudList T="string" Dense="true">
                <MudListItem T="string" Icon="@Icons.Material.Filled.ArrowRight">
                    <b>CL-35 — Tipo de fuente:</b> El banco exige Aptos 10 pt para uniformidad visual;
                    se detectó Arial 8 pt. Esto no viola la regulación CONDUSEF, pero afecta
                    la consistencia de marca.
                </MudListItem>
                <MudListItem T="string" Icon="@Icons.Material.Filled.ArrowRight">
                    <b>CL-37 — Contraste texto/fondo:</b> El estándar interno requiere relación ≥ 4.5:1
                    (WCAG AA). Se midió 3.1:1. Recomendación de accesibilidad del banco, no obligación CONDUSEF.
                </MudListItem>
            </MudList>
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Verdicts de tier: CONDUSEF = <MudChip T="string" Size="Size.Small" Color="Color.Success">GREEN</MudChip>
                &nbsp;· Banco = <MudChip T="string" Size="Size.Small" Color="Color.Warning">YELLOW</MudChip>
            </MudText>
        </MudPaper>

        <MudText Typo="Typo.h6" Class="mb-2">Datos del documento</MudText>
        <MudPaper Class="pa-3" Elevation="1">
            <MudSimpleTable Dense="true">
                <tbody>
                    <tr><td><b>Banco</b></td><td>@_case.ExtractedFields.BankName</td></tr>
                    <tr><td><b>Cuenta</b></td><td>@_case.ExtractedFields.MaskedAccount</td></tr>
                    <tr><td><b>Producto</b></td><td>@_case.ExtractedFields.ProductType</td></tr>
                    <tr><td><b>Período</b></td><td>@_case.ExtractedFields.Period</td></tr>
                    <tr><td><b>Saldo final</b></td><td>@_case.ExtractedFields.ClosingBalance.ToString("C2")</td></tr>
                    <tr><td><b>Movimientos</b></td><td>@_case.ExtractedFields.MovementCount</td></tr>
                    <tr><td><b>Páginas</b></td><td>@_case.ExtractedFields.PageCount</td></tr>
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private DemoStatementCase _case = null!;
    private IReadOnlyList<DemoFinding> _condusefFailFindings = [];
    private IReadOnlyList<DemoFinding> _bankFailFindings = [];

    protected override void OnInitialized()
    {
        _case = Demo.GetBySignal(VerdictSignal.Yellow)!;

        _condusefFailFindings = _case.Findings
            .Where(f => f.Verdict == FindingVerdict.Fail &&
                        (f.Tier == ChecklistTier.Condusef || f.Tier == ChecklistTier.Both))
            .ToList()
            .AsReadOnly();

        _bankFailFindings = _case.Findings
            .Where(f => f.Verdict == FindingVerdict.Fail && f.Tier == ChecklistTier.Bank)
            .ToList()
            .AsReadOnly();
    }
}
