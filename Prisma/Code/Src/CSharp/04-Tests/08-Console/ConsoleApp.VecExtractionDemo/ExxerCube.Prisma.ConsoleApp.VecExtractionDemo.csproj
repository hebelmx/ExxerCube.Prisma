<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ExxerCube.Prisma.ConsoleApp.VecExtractionDemo</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft Extensions for DI and Hosting -->
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="CSnakes.Runtime" />

    <!-- Serilog for structured logging -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />

    <!-- PDF Processing -->
    <PackageReference Include="PdfPig" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference Infrastructure.Python.VecExtraction project -->
    <ProjectReference Include="..\..\..\02-Infrastructure\Infrastructure.Python.VecExtraction\ExxerCube.Prisma.Infrastructure.Python.VecExtraction.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy Python module to output directory -->
    <None Include="..\..\..\..\..\Fixtures\PRP2\python\vec_visual_font_identification\**\*.py">
      <Link>python\vec_visual_font_identification\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>

    <!-- Copy test fixtures -->
    <None Include="..\..\..\..\..\Fixtures\PRP2\*.pdf">
      <Link>test_fixtures\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
