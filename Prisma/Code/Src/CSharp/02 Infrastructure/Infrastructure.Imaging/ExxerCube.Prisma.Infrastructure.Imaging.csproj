<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Target framework centrally managed - do not add another here -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- EmguCV for OpenCV operations -->
    <PackageReference Include="Emgu.CV" />
    <!-- FuzzySharp for fuzzy string matching -->
    <PackageReference Include="FuzzySharp" />
    <!-- Core dependencies -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="IndQuestResults" />
  </ItemGroup>
  <!-- Platform-specific EmguCV runtime -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Emgu.CV.runtime.windows" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <!-- Distro-pinned native build (Ubuntu 26.04). The generic ubuntu-x64 package stopped at
         4.12 and needs FFmpeg.58/VTK-9.1/HDF5-103 (absent on 26.04). NO PrivateAssets so the
         native libcvextern.so flows to consumer outputs (tests, Web.UI). UseRidGraph=true
         (Directory.Build.props, Linux) lets the SDK resolve this distro-specific RID asset. -->
    <PackageReference Include="Emgu.CV.runtime.ubuntu-26.04-x64" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\01 Core\Domain\ExxerCube.Prisma.Domain.csproj" />
  </ItemGroup>
</Project>