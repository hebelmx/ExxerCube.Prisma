<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Target framework centrally managed — do not add another here -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML documentation emitted so callers get IDE hover-docs -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- ASP.NET Core Identity + EF Core SQL Server -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Host + HTTP abstractions (IHostedService, IHttpContextAccessor) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <!-- IndQuestResults for Result<T> -->
    <PackageReference Include="IndQuestResults" />
  </ItemGroup>
  <ItemGroup>
    <!-- Domain owns the auth contract — infrastructure implements it -->
    <ProjectReference Include="..\..\01 Core\Domain\ExxerCube.Prisma.Domain.csproj" />
  </ItemGroup>
</Project>
