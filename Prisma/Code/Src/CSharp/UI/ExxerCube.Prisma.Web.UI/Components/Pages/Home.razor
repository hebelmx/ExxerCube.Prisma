@page "/"

<PageTitle>ExxerCube Prisma - OCR Processing System</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudPaper Class="pa-6" Elevation="3">
        <MudText Typo="Typo.h3" GutterBottom="true" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Class="mr-2" />
            ExxerCube Prisma OCR Processing System
        </MudText>
        
        <MudText Typo="Typo.body1" Class="mb-6">
            Welcome to the advanced OCR document processing system. This platform demonstrates the power of 
            machine learning and computer vision in extracting structured data from legal documents.
        </MudText>

        <!-- Feature Cards -->
        <MudGrid Class="mb-6">
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.DocumentScanner" Class="mr-2" />
                            Document Processing
                        </MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">
                            Upload legal documents and watch as our AI-powered OCR system extracts key information 
                            including expediente numbers, causes, dates, and monetary amounts.
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" 
                                   Href="ocr-demo" StartIcon="@Icons.Material.Filled.PlayArrow">
                            Try Demo
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Analytics" Class="mr-2" />
                            Real-Time Analytics
                        </MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">
                            Monitor processing performance with real-time metrics, success rates, 
                            and confidence scores. Track system health and processing queue status.
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Info" 
                                   Href="dashboard" StartIcon="@Icons.Material.Filled.Analytics">
                            View Dashboard
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
            
            <MudItem xs="12" md="4">
                <MudCard Elevation="2" Class="h-100">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6">
                            <MudIcon Icon="@Icons.Material.Filled.Psychology" Class="mr-2" />
                            AI-Powered Extraction
                        </MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudText Typo="Typo.body2">
                            Advanced machine learning algorithms extract structured data with high accuracy. 
                            Support for multiple document formats including PDF, PNG, JPG, and TIFF.
                        </MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" 
                                   Href="ocr-demo" StartIcon="@Icons.Material.Filled.Psychology">
                            Learn More
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        </MudGrid>

        <!-- Technology Stack -->
        <MudDivider Class="my-6" />
        <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.Build" Class="mr-2" />
            Technology Stack
        </MudText>
        
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudChip T="string" Color="Color.Primary" Size="Size.Large" Icon="@Icons.Material.Filled.Code">
                    .NET 10
                </MudChip>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudChip T="string" Color="Color.Secondary" Size="Size.Large" Icon="@Icons.Material.Filled.Code">
                    Python OCR
                </MudChip>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudChip T="string" Color="Color.Tertiary" Size="Size.Large" Icon="@Icons.Material.Filled.Web">
                    MudBlazor
                </MudChip>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudChip T="string" Color="Color.Info" Size="Size.Large" Icon="@Icons.Material.Filled.SignalCellular4Bar">
                    SignalR
                </MudChip>
            </MudItem>
        </MudGrid>

        <!-- Quick Start -->
        <MudDivider Class="my-6" />
        <MudText Typo="Typo.h5" GutterBottom="true" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Class="mr-2" />
            Quick Start
        </MudText>
        
        <MudAlert Severity="Severity.Info" Class="mb-4">
            <MudText Typo="Typo.body1">
                <strong>Ready to get started?</strong> Upload a legal document to see the OCR pipeline in action. 
                The system will extract key information and provide real-time processing updates.
            </MudText>
        </MudAlert>
        
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" 
                   Href="ocr-demo" StartIcon="@Icons.Material.Filled.DocumentScanner">
            Start Document Processing Demo
        </MudButton>
    </MudPaper>
</MudContainer>


