{
  "stryker-config": {
    "project": "ExxerCube.Prisma.Infrastructure.Classification.csproj",
    "test-projects": [
      "ExxerCube.Prisma.Tests.Infrastructure.Classification.csproj"
    ],
    "test-runner": "mtp",
    "mutate": [
      "**/FieldMatcherService.cs",
      "**/MatchingPolicyService.cs",
      "**/NameMatchingPolicy.cs",
      "**/LegalDirectiveClassifierService.cs"
    ],
    "coverage-analysis": "perTest",
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "concurrency": 4
  }
}
