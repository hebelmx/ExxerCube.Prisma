{
  "stryker-config": {
    "project": "ExxerCube.Prisma.Infrastructure.BrowserAutomation.csproj",
    "test-projects": [
      "ExxerCube.Prisma.Tests.Infrastructure.BrowserAutomation.csproj"
    ],
    "test-runner": "mtp",
    "mutate": [
      "**/Siara/SessionPassthroughSiaraSessionProvider.cs",
      "**/Siara/InteractiveLoginSiaraSessionProvider.cs",
      "**/Siara/AutomatedLoginSiaraSessionProvider.cs",
      "**/Siara/SiaraLoginCircuitBreaker.cs",
      "**/Siara/SiaraSessionProviderResolver.cs",
      "**/Siara/ConfiguredSiaraCredentialSource.cs",
      "**/Siara/ConfiguredSiaraActorIdentityProvider.cs",
      "**/Siara/SiaraHostPolicy.cs",
      "**/Services/SiaraLoginService.cs"
    ],
    "additional-timeout": 30000,
    "coverage-analysis": "perTest",
    "reporters": [
      "html",
      "progress",
      "cleartext"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "concurrency": 4
  }
}
