{
  // Veriqan VEC worker — developer-friendly defaults.
  // Keys that have no safe default are intentionally left empty so the startup
  // validator can detect them and emit a structured WARNING (not a crash).
  // Copy appsettings.Production.json.template → appsettings.Production.json
  // and fill in every <REPLACE_ME> before deploying to any non-development environment.
  "ConnectionStrings": {
    // When absent the worker falls back to in-memory persistence and logs a WARNING.
    // Provide a valid SQL Server connection string for durable storage.
    "VeriqanDb": ""
  },
  "Veriqan": {
    "OtlpEndpoint": "http://localhost:4317",
    "Seq": {
      // When non-empty, Serilog will also write to this Seq server.
      // Leave blank (or omit) to disable the Seq sink — an empty value will NOT crash the worker.
      "ServerUrl": ""
    },
    "CsvReferenceData": {
      // Root directory containing institution-specific CSV sub-directories.
      // Sub-directory names must match institution names with spaces replaced by underscores.
      // Example: "C:\\ReferenceData\\csv\\"
      "RootDirectory": ""
    },
    "Smtp": {
      // SMTP host used for RED-verdict alert emails.
      "Host": "localhost",
      "Port": 25,
      "EnableSsl": false,
      "From": "noreply@veriqan.local",
      "UserName": null,
      "Password": null
    },
    "Alerts": {
      // Recipient list for RED-verdict alerts. Must contain at least one address
      // for alert dispatch to succeed.
      "Recipients": [],
      "MaxRetryAttempts": 3,
      "BaseRetryDelayMs": 500
    },
    "LegalBaseline": {
      // Base64-encoded 32-byte AES-256 key used to encrypt tolerance values at rest.
      // Required when ConnectionStrings:VeriqanDb is present (SQL persistence path).
      // Generate with: [Convert]::ToBase64String((1..32 | %{0}) -as [byte[]])
      // NEVER commit a real production key here — use environment variables or Key Vault.
      "EncryptionKey": ""
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
