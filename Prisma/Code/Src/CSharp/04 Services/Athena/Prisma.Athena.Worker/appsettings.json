{
  "ConnectionStrings": {
    "DefaultConnection": "DEV-PLACEHOLDER: set via ConnectionStrings__DefaultConnection env var or user-secrets; e.g. Server=localhost\\SQL2022;Database=Prisma;Integrated Security=True;Encrypt=True;TrustServerCertificate=True"
  },
  "Siara": {
    "Actor": {
      "ActorId": "athena-extractor-dev",
      "DisplayName": "Athena Extractor"
    }
  },
  "ProcessIdentity": {
    "JwtSecret": "DEV-ONLY-PLACEHOLDER-REPLACE-VIA-ENV-OR-KEYVAULT-IN-PRODUCTION",
    "JwtIssuer": "prisma-pipeline",
    "JwtAudience": "prisma-pipeline",
    "TokenLifetime": "00:05:00",
    "Clearance": "Extract"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq", "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "%SEQ_URL%"
        }
      },
      {
        "_note": "G-S2: SQL Server structured-log sink. Activate in production by setting ConnectionStrings__DefaultConnection (same connection string used by EF Core). Disabled in dev when the connection string is blank or the placeholder value; the sink library handles a null/empty connectionString gracefully by skipping initialization.",
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "%SERILOG_SQL_CONNECTION%",
          "sinkOptionsSection": "Serilog:SinkOptions:MSSqlServer",
          "restrictedToMinimumLevel": "Warning"
        }
      }
    ],
    "SinkOptions": {
      "MSSqlServer": {
        "tableName": "SerilogLogs",
        "autoCreateSqlTable": true,
        "schemaName": "dbo"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "ExxerCube.Prisma.Athena.Worker"
    }
  }
}
