# =============================================================================
# ExxerCube.Prisma — required environment variables
# =============================================================================
# Copy this file to .env (which is gitignored) and fill in values for your
# local environment. In CI/CD and production, inject these as real env vars.
#
# ASP.NET Core env-var override convention:
#   JSON key "ConnectionStrings:DefaultConnection"
#   → env var  ConnectionStrings__DefaultConnection  (double underscore = nesting)
#
# =============================================================================

# ---------------------------------------------------------------------------
# Web.UI — SQL Server connection strings
# Required: Program.cs throws at startup when DefaultConnection is missing/empty.
# ---------------------------------------------------------------------------

# Identity database (ASP.NET Core Identity)
ConnectionStrings__DefaultConnection=Server=<YOUR_SQL_HOST>\<INSTANCE>;Database=PrismaID;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# Application database (EF Core domain data)
ConnectionStrings__ApplicationConnection=Server=<YOUR_SQL_HOST>\<INSTANCE>;Database=Prisma;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# Examples:
#   Local SQL Express : Server=.\SQLEXPRESS;Database=PrismaID;...
#   LocalDB           : Server=(localdb)\MSSQLLocalDB;Database=PrismaID;...
#   Docker SQL Server : Server=localhost,1433;Database=PrismaID;User Id=sa;Password=<pwd>;...

# ---------------------------------------------------------------------------
# Web.UI — SIARA Simulator URL
# Used by NavigationTargets:SiaraUrl (browser-automation scraper target).
# Point at the Siara.Simulator when running locally; in production point at
# the real SIARA portal URL.
# ---------------------------------------------------------------------------
NavigationTargets__SiaraUrl=https://localhost:5002

# ---------------------------------------------------------------------------
# Siara.Simulator — log file path (Production environment only)
# Serilog File sink path for the simulator process.
# Defaults to relative "logs/siara-.log" in the committed config;
# override here for a canonical production path.
# ---------------------------------------------------------------------------
SIARA_LOG_PATH=logs/siara-.log
# Production example: SIARA_LOG_PATH=/var/log/siara/siara-.log

# ---------------------------------------------------------------------------
# Optional / observability
# ---------------------------------------------------------------------------

# Seq log aggregation endpoint (used by both Web.UI and Siara.Simulator)
# Leave empty to disable Seq sink.
Seq__ServerUrl=http://localhost:5341

# ASP.NET Core environment selector (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development
