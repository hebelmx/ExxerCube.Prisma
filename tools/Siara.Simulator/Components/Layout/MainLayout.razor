@inherits LayoutComponentBase

<div class="page">
    <header class="app-header">
        <div class="logo-container">
            <img src="/logo-siara.jpg" alt="SIARA Logo" style="height: 50px; width: auto; object-fit: contain;" />
            <h1>Sistema de Atención de Requerimientos de Autoridad (SIARA)</h1>
        </div>
        <div class="user-controls">
            <AuthorizeView>
                <Authorized>
                    <form method="post" action="/auth/logout" style="display: inline;" data-enhance="false">
                        <button type="submit" class="btn btn-sm btn-outline-light">Cerrar Sesión (Logout)</button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="app-content">
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
