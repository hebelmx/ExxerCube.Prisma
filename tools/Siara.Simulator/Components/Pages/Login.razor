    .siara-login-page {
        min-height: 100vh;
        background: linear-gradient(135deg, #f5f5f5 0%, #e0e0e0 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* Government Banner */
    .government-banner {
        background: linear-gradient(90deg, #6d1f1f 0%, #8b2e2e 100%);
        color: white;
        padding: 15px 0;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .banner-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .gov-seal {
        width: 60px;
        height: 60px;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }

    .gov-text h1 {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .gov-text .subtitle {
        font-size: 14px;
        opacity: 0.9;
    }

    /* SIARA Header */
    .siara-header {
        background: white;
        border-bottom: 4px solid #8b2e2e;
        padding: 20px 0;
    }

    .siara-header-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        text-align: center;
    }

    .siara-header h2 {
        font-size: 36px;
        font-weight: 700;
        color: #6d1f1f;
        margin-bottom: 5px;
    }

    .siara-header p {
        font-size: 16px;
        color: #555;
        margin-bottom: 10px;
    }

    .simulation-badge {
        margin-top: 10px;
    }

    .badge-text {
        display: inline-block;
        background: #ff6b35;
        color: white;
        padding: 8px 20px;
        border-radius: 20px;
        font-weight: 700;
        font-size: 14px;
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; }
