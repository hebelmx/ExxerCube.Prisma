@page "/login"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject Siara.Simulator.Services.SiaraCredentialValidator Validator
@inject NavigationManager NavManager
@inject ILogger<Login> Logger

<div class="siara-login-page">
    <!-- Top Banner with Government Branding -->
    <div class="government-banner">
        <div class="banner-content">
            <div class="gov-logos">
                <img src="/logo-gobierno.jpg" alt="Gobierno de México" class="gov-seal" />
            </div>
            <div class="gov-text">
                <h1>Gobierno de México</h1>
                <p class="subtitle">Comisión Nacional Bancaria y de Valores</p>
            </div>
        </div>
    </div>

    <!-- SIARA Header -->
    <div class="siara-header">
        <div class="siara-header-content">
            <h2>SIARA</h2>
            <p>Sistema de Atención de Requerimientos de Autoridad</p>
            <div class="simulation-badge">
                <span class="badge-text">⚠️ SIMULACIÓN - ENTORNO DE PRUEBAS ⚠️</span>
            </div>
        </div>
    </div>

    <!-- Login Form Container -->
    <div class="login-container">
        <div class="login-card">
            <div class="card-header">
                <h3>Acceso al Sistema</h3>
                <p>Portal de Instituciones Financieras</p>
            </div>

            <div class="card-body">
                <EditForm Model="Model" OnValidSubmit="HandleLoginAsync" FormName="loginForm" method="post">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label for="username" class="form-label">
                            <strong>Usuario:</strong>
                        </label>
                        <InputText
                            id="username"
                            class="form-input"
                            @bind-Value="Model.Username"
                            placeholder="Ingrese su usuario"
                            autocomplete="username" />
                    </div>

                    <div class="form-group">
                        <label for="password" class="form-label">
                            <strong>Contraseña:</strong>
                        </label>
                        <InputText
                            id="password"
                            type="password"
                            class="form-input"
                            @bind-Value="Model.Password"
                            placeholder="Ingrese su contraseña"
                            autocomplete="current-password" />
                        <ValidationMessage For="@(() => Model.Password)" />
                    </div>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert-error">
                            <strong>Error:</strong> @_errorMessage
                        </div>
                    }

                    <button type="submit" class="btn-login">
                        Ingresar al Sistema
                    </button>
                </EditForm>

                <div class="help-text">
                    <p><small>💡 <strong>Nota de Simulación:</strong> credenciales de prueba — Usuario: <strong>BANAMEX</strong> · Contraseña: <strong>password123</strong>. Tras varios intentos fallidos la cuenta se bloquea temporalmente, como en el SIARA real.</small></p>
                </div>
            </div>
        </div>

        <div class="security-notice">
            <p><strong>Aviso de Seguridad:</strong></p>
            <p>Este es un entorno de simulación para pruebas. No ingrese información real o confidencial.</p>
        </div>
    </div>

    <!-- Footer -->
    <div class="page-footer">
        <div class="footer-content">
            <p>&copy; @DateTime.Now.Year Comisión Nacional Bancaria y de Valores</p>
            <p class="simulation-notice">ENTORNO DE SIMULACIÓN - NO ES EL SISTEMA REAL</p>
        </div>
    </div>
</div>

<style>
