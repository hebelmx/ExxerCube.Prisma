    }

    /* Login Container */
    .login-container {
        max-width: 500px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .login-card {
        background: white;
        border-radius: 8px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.15);
        overflow: hidden;
    }

    .card-header {
        background: linear-gradient(135deg, #6d1f1f 0%, #8b2e2e 100%);
        color: white;
        padding: 25px;
        text-align: center;
    }

    .card-header h3 {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 8px;
    }

    .card-header p {
        font-size: 14px;
        opacity: 0.95;
    }

    .card-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin-bottom: 8px;
        color: #333;
        font-size: 14px;
    }

    .form-input {
        width: 100%;
        padding: 12px 15px;
        border: 2px solid #ddd;
        border-radius: 4px;
        font-size: 14px;
        transition: border-color 0.3s;
    }

    .form-input:focus {
        outline: none;
        border-color: #8b2e2e;
    }

    .form-input::placeholder {
        color: #999;
    }

    .alert-error {
        background: #fee;
        border: 1px solid #fcc;
        color: #c33;
        padding: 12px;
        border-radius: 4px;
        margin-bottom: 15px;
    }

    .btn-login {
        width: 100%;
        background: linear-gradient(135deg, #6d1f1f 0%, #8b2e2e 100%);
        color: white;
        border: none;
        padding: 14px 20px;
        font-size: 16px;
        font-weight: 700;
        border-radius: 4px;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        margin-top: 10px;
    }

    .btn-login:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(109, 31, 31, 0.3);
    }

    .btn-login:active {
        transform: translateY(0);
    }

    .help-text {
        margin-top: 20px;
        padding: 15px;
        background: #fffbea;
        border: 1px solid #ffe066;
        border-radius: 4px;
        text-align: center;
    }

    .help-text p {
        color: #666;
        font-size: 13px;
        margin: 0;
    }

    .security-notice {
        margin-top: 20px;
        padding: 15px;
        background: #fff3cd;
        border: 2px solid #ffc107;
        border-radius: 6px;
        text-align: center;
    }

    .security-notice p {
        margin: 5px 0;
        color: #856404;
        font-size: 13px;
    }

    .security-notice p:first-child {
        font-weight: 700;
    }

    /* Footer */
    .page-footer {
        background: #333;
        color: white;
        padding: 20px 0;
        margin-top: 60px;
        text-align: center;
    }

    .footer-content p {
        margin: 5px 0;
        font-size: 13px;
    }

    .simulation-notice {
        color: #ffc107;
        font-weight: 700;
        margin-top: 8px;
    }

    /* Responsive Design */
    @@media (max-width: 600px) {
        .banner-content {
            flex-direction: column;
            text-align: center;
        }

        .siara-header h2 {
            font-size: 28px;
        }

        .login-container {
            margin: 20px auto;
        }

        .card-body {
            padding: 20px;
        }
    }
</style>

@code {
    // Static SSR cookie sign-in: HttpContext is available during the form POST, so SignInAsync can
    // write the Set-Cookie header. (Interactive components run over the SignalR circuit, where there
    // is no HttpContext to sign into — which is why this page stays static SSR.)
    [CascadingParameter]
    public HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    public LoginModel Model { get; set; } = new();

    private string? _errorMessage;

    private async Task HandleLoginAsync()
    {
        var result = Validator.Validate(Model.Username, Model.Password);
        if (!result.Success)
        {
            _errorMessage = result.ErrorMessage;
            Logger.LogInformation("Login rejected for {User}: {Reason}", Model.Username, _errorMessage);
            return;
        }

        var claims = new List<Claim>
        {
            new(ClaimTypes.Name, Model.Username),
            new("siara:institution", Model.Username),
        };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));

        Logger.LogInformation("Login successful for {User}; SIARA session cookie issued", Model.Username);
        NavManager.NavigateTo("/");
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre de usuario es requerido.")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es requerida.")]
        public string Password { get; set; } = string.Empty;
    }
}
