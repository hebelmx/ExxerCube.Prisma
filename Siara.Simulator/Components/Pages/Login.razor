@page "/login"
@inject Siara.Simulator.Services.AuthenticationService AuthService
@inject NavigationManager NavManager
@inject ILogger<Login> Logger

<div class="login-container">
    <div class="login-box">
        <div class="login-header">
            <img src="/logo.png" alt="Government Seal" />
            <div>
                <h3>Sistema de Atención de Requerimientos de Autoridad</h3>
                <p>(SIMULACIÓN)</p>
            </div>
        </div>
        
        <h4 class="login-title">Acceso al Portal de Instituciones Financieras</h4>

        <EditForm Model="@_model" OnSubmit="HandleLogin" FormName="loginForm">
            <DataAnnotationsValidator />

            <div class="form-group mb-3">
                <label for="username">Usuario:</label>
                <InputText id="username" class="form-control" @bind-Value="_model.Username" placeholder="Institución Financiera" />
            </div>

            <div class="form-group mb-3">
                <label for="password">Contraseña de Acceso:</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="_model.Password" />
                <ValidationMessage For="@(() => _model.Password)" />
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger mt-2" role="alert">
                    @_errorMessage
                </div>
            }

            <button type="submit" class="btn btn-primary btn-block mt-3">Ingresar</button>
        </EditForm>
        
        <div class="login-footer">
            <p>&copy; @DateTime.Now.Year - Comisión Nacional Bancaria y de Valores (Simulación)</p>
        </div>
    </div>
</div>

@code {
    private readonly LoginModel _model = new();
    private string? _errorMessage;

    private void HandleLogin()
    {
        Logger.LogInformation("HandleLogin called - Demo mode, auto-login");

        // DEMO: Just hardcode login success
        AuthService.Login("password123");

        Logger.LogInformation("Auto-login successful, navigating to /");
        NavManager.NavigateTo("/", forceLoad: true);
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre de usuario es requerido.")]
        public string Username { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "La contraseña es requerida.")]
        public string Password { get; set; } = string.Empty;
    }
}
