@inject Siara.Simulator.Services.AuthenticationService AuthService
@inject NavigationManager NavManager

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (AuthService.IsAuthenticated)
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(Components.Layout.MainLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        }
        else
        {
            <RedirectToLogin />
        }
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="typeof(Components.Layout.MainLayout)">
            <p role="alert">Sorry, there's nothing at this address.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    // This component is a simple helper to perform the navigation.
    // It's placed here to keep it self-contained with the Routes component that uses it.
    private IComponent RedirectToLogin => new RedirectToLoginComponent();

    private class RedirectToLoginComponent : IComponent
    {
        [Inject] private NavigationManager NavManager { get; set; } = default!;

        public void Attach(RenderHandle renderHandle)
        {
            NavManager.NavigateTo("/login");
        }

        public Task SetParametersAsync(ParameterView parameters) => Task.CompletedTask;
    }
}