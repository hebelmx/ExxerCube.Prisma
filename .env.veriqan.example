# =============================================================================
# ExxerCube.Prisma — Veriqan VEC Worker environment variables
# =============================================================================
# Copy this file to .env.veriqan (which is gitignored) and fill in values.
# In CI/CD and production, inject these as real env vars — do NOT commit
# a .env.veriqan file containing real secrets to source control.
#
# Used by: docker-compose.veriqan.yml
# =============================================================================

# ---------------------------------------------------------------------------
# APP_VERSION — MinVer version stamp for `docker compose ... up --build` (O7)
# ---------------------------------------------------------------------------
# Passed as a build ARG to veriqan-worker and veriqan-web-ui (the two `build:`
# sections in docker-compose.veriqan.yml); each Dockerfile sets
# ENV MinVerVersionOverride=${APP_VERSION}, which bypasses git entirely inside
# the build (the .dockerignore-excluded .git/ tree would otherwise leave MinVer
# blind). Without this var set, both images silently bake the compose-file
# default 0.0.0-compose — recreating the exact "constant EngineVersion" defect
# O7 fixed. MinVer 7.0.0 requires the override to be either a bare SemVer/pre-
# release string (no "v" prefix — MinVerTagPrefix is NOT applied to overrides)
# or, when no tag is reachable, a synthetic MAJOR.MINOR.PATCH-suffixed value.
# Derive it the same way CI does, right before `docker compose ... up --build`:
#   APP_VERSION=$(git describe --tags --always)
#   APP_VERSION=${APP_VERSION#v}
#   case "$APP_VERSION" in *.*) ;; *) APP_VERSION="0.0.0-sha.$APP_VERSION";; esac
#   export APP_VERSION
# The placeholder below is a valid-SemVer default for ad-hoc local builds;
# replace it by re-running the derivation snippet whenever you want the image
# to carry a real, git-traceable version.
APP_VERSION=0.0.0-local

# ---------------------------------------------------------------------------
# SQL Server SA password
# Required: SQL Server will refuse to start without a strong SA password.
# Constraints: ≥8 chars, must include uppercase, lowercase, digit, and symbol.
# ---------------------------------------------------------------------------
VERIQAN_SA_PASSWORD=<CHANGE_ME_strong_password_1!>

# ---------------------------------------------------------------------------
# AES-256 encryption key for at-rest tolerance values
# Required when SQL persistence is active (ConnectionStrings__VeriqanDb is set).
# Generate a new key: openssl rand -base64 32
# ---------------------------------------------------------------------------
VERIQAN_ENCRYPTION_KEY=<CHANGE_ME_base64_32_byte_key>

# ---------------------------------------------------------------------------
# SMTP relay settings (required for RED-verdict alert email dispatch)
# Leave VERIQAN_SMTP_USER and VERIQAN_SMTP_PASSWORD blank for open-relay.
# ---------------------------------------------------------------------------
VERIQAN_SMTP_HOST=smtp.example.com
VERIQAN_SMTP_USER=
VERIQAN_SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Alert recipients — JSON array of email addresses.
# Must contain at least one address for alert dispatch to succeed.
# Example: ["ops@example.com","compliance@example.com"]
# ---------------------------------------------------------------------------
VERIQAN_ALERT_RECIPIENTS=["ops@example.com"]

# ---------------------------------------------------------------------------
# Optional / observability
# ---------------------------------------------------------------------------

# ASP.NET Core environment selector (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# OTLP gRPC endpoint for OpenTelemetry trace and metric export.
# Default: http://localhost:4317 (standard OTLP gRPC port).
# When running alongside a full Prisma stack: http://seq:4317
OTLP_ENDPOINT=http://localhost:4317

# Seq structured-log server URL.
# Leave empty to disable the Seq sink — an empty value will NOT crash the worker.
# When running alongside a full Prisma stack: http://seq:80
SEQ_URL=
